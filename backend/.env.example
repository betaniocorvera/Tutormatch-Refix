APP_ENV=development
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PERSIST_TO_FILE=false
STORE_PATH=data/store.json
UPLOAD_DIR=data/uploads
SNAPSHOT_DEBOUNCE_SECONDS=0.5
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
CORS_ORIGINS=http://localhost:8080
# PostgreSQL is not wired into the app yet. Set DATABASE_URL when running
# Alembic or later SQL work; setting it now does not switch app storage.
# Example: postgresql+psycopg://tutormatch:change-me@localhost:5432/tutormatch
DATABASE_URL=
TEST_DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_ECHO=false
DATABASE_SSL_MODE=
